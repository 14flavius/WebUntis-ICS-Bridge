# Local development: created automatically by `bash scripts/setup.sh`.
# Docker installations get their own .env from scripts/install.sh.
# Keep both independently generated secrets private and unchanged.
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# Exact browser URL. Local development uses the Vite address.
PUBLIC_URL=http://127.0.0.1:5173

# Local Node.js server.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/bridge.sqlite

# Docker only (read by docker-compose.yml):
# HOST_PORT=3000
# BIND_ADDRESS=127.0.0.1
# COMPOSE_PROJECT_NAME=webuntis-ics-bridge
# BRIDGE_IMAGE=ghcr.io/14flavius/webuntis-ics-bridge:1.0.1
